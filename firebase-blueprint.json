{
  "entities": {
    "AuthorizedUser": {
      "title": "Authorized User",
      "description": "User allowed to access the application",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the user is allowed to access"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the user was added"
        }
      },
      "required": ["email", "active", "created_at"]
    }
  },
  "firestore": {
    "/authorized_users/{userId}": {
      "schema": "AuthorizedUser",
      "description": "Collection of authorized users"
    }
  }
}
