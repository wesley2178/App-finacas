rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'wesley2178@gmail.com';
    }

    // A user is authorized if they are an admin or have a profile with isAuthorized == true
    function isAuthorized(userId) {
      return isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/users/$(userId)).data.isAuthorized == true);
    }

    // Profile rules
    match /users/{userId} {
      // Allow any signed in user to read their own profile
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      allow create: if isOwner(userId) 
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isAdmin == (request.auth.token.email == 'wesley2178@gmail.com')
        && request.resource.data.createdAt != null;

      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAuthorized', 'isAdmin']));
    }

    // Subcollections (Earnings, bills, etc)
    match /users/{userId}/{collectionName}/{docId} {
      allow read, write: if isOwner(userId) && isAuthorized(userId);
    }

    // Catch-all deny for any other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
