rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'wesley2178@gmail.com';
    }

    function isAuthorizedUser(userId) {
      return isAdmin() || (get(/databases/$(database)/documents/users/$(userId)).data.isAuthorized == true);
    }

    function isVerifiedUser() {
      return isSignedIn(); // Relaxed, as we rely on Google Auth identity
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      // Users can read their own profile
      // Admin can read all profiles to authorize them
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow creation of profile on first sign-in
      allow create: if isOwner(userId) 
        && isVerifiedUser()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.isAdmin == (request.auth.token.email == 'wesley2178@gmail.com')
        && request.resource.data.isAuthorized == (request.auth.token.email == 'wesley2178@gmail.com')
        && request.resource.data.createdAt == request.time;

      // Admin can update isAuthorized
      allow update: if isAdmin() 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAuthorized']);
    }

    // User data subcollections
    match /users/{userId}/{collectionName}/{docId} {
      // Strict isolation: User can only access their own data
      // Only if authorized
      allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin());
      
      // Specifically for the subcollections
      match /earnings/{id} { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
      match /bills/{id} { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
      match /deposits/{id} { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
      match /expenses/{id} { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
      match /archives/{id} { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
      match /config/categories { allow read, write: if isOwner(userId) && (isAuthorizedUser(userId) || isAdmin()); }
    }
  }
}
