rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Access control collection
    match /authorized_users/{userId} {
      // Allow read access to verify user status
      allow read: if true;
      allow write: if false;
    }
  }
}
