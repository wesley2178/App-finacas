rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permissive for testing access control
    match /authorized_users/{userId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default deny for others
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
